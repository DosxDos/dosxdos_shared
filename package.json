{
  "name": "@dosxdos/ui",
  "version": "0.17.0",
  "private": true,
  "description": "Componentes compartidos entre los modulos de Dos por Dos, en Next o en Vite.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "react-icons": ">=5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "publicar": "node publicar.mjs"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
